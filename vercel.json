{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    { "src": "/$", "dest": "/api/main.php" },
    { "src": "/assets/(.*)", "dest": "/api/assets/$1" },
    { "src": "/(.*\\.css)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}
